{
  "manifest_version": 3,
  "name": "Notch Inbox Link",
  "version": "1.7.0",
  "description": "Passes your unread Gmail, in full, to the Notch Inbox app on this Mac. Nothing is sent anywhere else.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://127.0.0.1:47823/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Notch Inbox Link",
    "default_popup": "popup.html"
  }
}
